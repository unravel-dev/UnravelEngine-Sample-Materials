      },
      {
       "id": "ripples",
       "type": "custom",
       "position": {
        "x": 0.0,
        "y": 0.0
       },
       "inputs": [
        {
         "pin": "a",
         "link": "across",
         "value": [
          0.0
         ]
        },
        {
         "pin": "b",
         "link": "shape",
         "value": [
          0.0
         ]
        },
        {
         "pin": "c",
         "link": "ripple_clock",
         "value": [
          0.0
         ]
        }
       ],
       "settings": [
        {
         "name": "output",
         "value": "float"
        },
        {
         "name": "code",
         "value": "// The pool's ripples: the waves whose light the floor's caustics trace, as tall as they stand on water 2 m deep.\n// a: the point (world X, Z). b: x Ripple Size, y Focus, z Ripple Height. c: the time times the speed.\nfloat size = max(b.x, 0.01);\nfloat focus = b.y;\nfloat clock = c;\nfloat footprint = max(length(dFdx(a)), length(dFdy(a))) + 1e-5;\nvec2 p = a;\nfloat height = 0.0;\nfor (int n = 0; n < 16; n++)\n{\n\tfloat f_n = (float(n) + 0.5) / 16.0;\n\tfloat base_n = 0.08 * pow(7.5, f_n);\n\tfloat wavelength = base_n * size;\n\tfloat k = 6.2831853 / wavelength;\n\tfloat angle = float(n) * 2.3999632;\n\tvec2 dir = vec2(cos(angle), sin(angle));\n\tfloat omega = sqrt(9.81 * k + 7.3e-5 * k * k * k);\n\tfloat theta = k * dot(dir, p) - omega * clock + fract(float(n) * 0.618034) * 6.2831853;\n\tfloat bend = focus * 6.450075 * pow(base_n / 6.2831853, 0.75) * saturate(wavelength / footprint * 0.25 - 0.5);\n\theight += bend / (0.5 * k * k) * sin(theta);\n}\nreturn height * b.z;\n"
        },
        {
         "name": "name",
         "value": "Ripples"
        }
       ]
      },
