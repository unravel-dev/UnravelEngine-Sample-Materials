<html>
<head>
    <title>Material Gallery HUD</title>
    <link type="text/rcss" href="engine:/data/ui/rml.rcss"/>
    <link type="text/rcss" href="app:/data/UI/gallery_hud.rcss"/>
</head>
<!--
    GalleryTour (Scripts/GalleryTour.cs) fills bay-title, bay-text and bay-index for the stop the camera is at, and
    takes clicks on previous, next and tour: the touch controls on phones and in the browser.
-->
<body>
    <div id="panel">
        <div id="info">
            <div id="header">
                <div id="brand">UNRAVEL ENGINE &#183; MATERIAL GALLERY</div>
                <div id="bay-index">1 / 8</div>
            </div>
            <div id="bay-title">Material Gallery</div>
            <div id="bay-text">Every surface in this hall is a material graph.</div>
        </div>
        <div id="controls">
            <button id="previous" class="nav">&#8249;</button>
            <button id="tour" class="nav wide">Play Tour</button>
            <button id="next" class="nav">&#8250;</button>
        </div>
        <div id="keys">1-9, 0, - bays &#183; Left / Right &#183; Space tour &#183; F fly (right mouse, WASD) &#183; drag to slash</div>
    </div>
</body>
</html>
