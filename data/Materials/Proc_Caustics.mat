      },
      {
       "id": "caustics",
       "type": "custom",
       "position": {
        "x": 0.0,
        "y": 0.0
       },
       "inputs": [
        {
         "pin": "a",
         "link": "across",
         "value": [
          0.0
         ]
        },
        {
         "pin": "b",
         "link": "shape",
         "value": [
          0.0
         ]
        },
        {
         "pin": "c",
         "link": "ripple_clock",
         "value": [
          0.0
         ]
        }
       ],
       "settings": [
        {
         "name": "output",
         "value": "vec3"
        },
        {
         "name": "code",
         "value": "// Light from above refracts through the rippled surface and gathers into lines on the floor.\n// a: the point (world X, Z). b: x Ripple Size, y Focus, z Dispersion. c: the time times the speed.\n// The point is traced back to where its light crossed the surface; the curvature of the surface there focuses\n// that light (the Jacobian of the refraction). Returns the light per channel, 1 under still water.\nfloat size = max(b.x, 0.01);\nfloat focus = b.y;\nfloat clock = c;\nfloat footprint = max(length(dFdx(a)), length(dFdy(a))) + 1e-5;\nvec2 p = a;\nvec2 shift = vec2_splat(0.0);\nfor (int n = 0; n < 16; n++)\n{\n\tfloat f_n = (float(n) + 0.5) / 16.0;\n\tfloat base_n = 0.08 * pow(7.5, f_n);\n\tfloat wavelength = base_n * size;\n\tfloat k = 6.2831853 / wavelength;\n\tfloat angle = float(n) * 2.3999632;\n\tvec2 dir = vec2(cos(angle), sin(angle));\n\tfloat omega = sqrt(9.81 * k + 7.3e-5 * k * k * k);\n\tfloat theta = k * dot(dir, p) - omega * clock + fract(float(n) * 0.618034) * 6.2831853;\n\tfloat bend = focus * 6.450075 * pow(base_n / 6.2831853, 0.75) * saturate(wavelength / footprint * 0.25 - 0.5);\n\tshift += dir * (bend / k * cos(theta));\n}\nvec2 origin = a - shift;\np = origin;\nvec3 curve = vec3_splat(0.0);\nfor (int m = 0; m < 16; m++)\n{\n\tfloat f_m = (float(m) + 0.5) / 16.0;\n\tfloat base_m = 0.08 * pow(7.5, f_m);\n\tfloat wavelength = base_m * size;\n\tfloat k = 6.2831853 / wavelength;\n\tfloat angle = float(m) * 2.3999632;\n\tvec2 dir = vec2(cos(angle), sin(angle));\n\tfloat omega = sqrt(9.81 * k + 7.3e-5 * k * k * k);\n\tfloat theta = k * dot(dir, p) - omega * clock + fract(float(m) * 0.618034) * 6.2831853;\n\tfloat bend = focus * 6.450075 * pow(base_m / 6.2831853, 0.75) * saturate(wavelength / footprint * 0.25 - 0.5);\n\tcurve -= vec3(dir.x * dir.x, dir.x * dir.y, dir.y * dir.y) * (bend * sin(theta));\n}\n// Red bends a little less than green, blue a little more (water's refractive index by wavelength).\nvec3 spread = vec3(1.0 - 0.0045 * b.z, 1.0, 1.0 + 0.0099 * b.z);\nfloat flat_det = (1.0 + curve.x) * (1.0 + curve.z) - curve.y * curve.y;\nfloat soften = 0.05 + 0.6 * fwidth(flat_det);\nvec3 det = (1.0 + curve.x * spread) * (1.0 + curve.z * spread) - curve.y * curve.y * spread * spread;\nvec3 light = vec3_splat(1.0) / sqrt(det * det + soften * soften);\nreturn light / (1.0 + 0.72 * smoothstep(0.2, 0.6, focus));\n"
        },
        {
         "name": "name",
         "value": "Caustics"
        }
       ]
      },
